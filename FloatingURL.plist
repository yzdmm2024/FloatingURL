<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Filter</key>
	<dict>
		<!-- roothide/ellekit 不支持 Mode=AnyApplication（实测完全不注入，导致悬浮按钮从不出）。
		     改用 Bundles=com.apple.UIKit：所有 App 都加载 UIKit，等价于全局注入，
		     这是 MyGestures 等已在你设备上验证生效的全局注入写法。
		     com.apple.Preferences 在代码层 %ctor 里跳过（避开看门狗）；
		     com.apple.springboard 由 Tweak.xm 的 INCLUDE_SPRINGBOARD 控制（当前=1，主屏幕也显示）。 -->
		<key>Bundles</key>
		<array>
			<string>com.apple.UIKit</string>
		</array>
	</dict>
</dict>
</plist>
