#!/bin/bash
# v1.3.17：不再自动 killall SpringBoard。改为「写旗标 + 发通知」，由运行中的 tweak
# 弹出「立即注销 / 稍后」选择框让用户决定。
# 注意：从 1.3.16 或更早版本升上来的这一次，旧版 tweak 里还没有弹窗逻辑，
# 所以本次升级需要手动注销一次；之后的版本升级就会弹窗可选了。
FLAG=/var/mobile/Media/FloatingURL_respring
: > "$FLAG" 2>/dev/null || touch "$FLAG" 2>/dev/null
chown mobile:mobile "$FLAG" 2>/dev/null
notifyutil -p com.yzdmm.floatingurl/needsRespring 2>/dev/null
exit 0
