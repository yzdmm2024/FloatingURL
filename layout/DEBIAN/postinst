#!/bin/bash
# 安装后：写旗标 + 发通知，由运行中的 tweak 弹「立即注销 / 稍后」选择框。
# v1.4.1：新增 killall Settings —— 设置 App 进程会一直驻留旧版偏好面板二进制，
#   导致升级后 Root.plist 显示了新按钮、点下去却是旧代码（没反应/没新功能）。
#   杀掉设置进程，下次打开即加载全新 bundle。失败也不影响安装收尾。
# v1.3.30：写旗标全程容错 —— 先 mkdir -p 再写，任何一步失败都不算安装错误。
FLAG=/var/mobile/Media/FloatingURL_respring
{ mkdir -p "$(dirname "$FLAG")" 2>/dev/null; : > "$FLAG"; } 2>/dev/null || true
chown mobile:mobile "$FLAG" 2>/dev/null || true
notifyutil -p com.yzdmm.floatingurl/needsRespring 2>/dev/null || true
killall Settings 2>/dev/null || true
exit 0
